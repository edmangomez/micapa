# MICAPA - Configuración de Variables de Entorno

# Puerto del servidor (opcional)
PORT=3001

# Clave secreta JWT para autenticación administrativa
JWT_SECRET=micapa_secret_key_change_in_production

# ===================================================================
# CONFIGURACIÓN DE ENVÍO DE CORREOS ELECTRÓNICOS (SMTP)
# ===================================================================
# Recomendado: Gmail con Contraseña de Aplicación (App Password)
# 1. Ve a https://myaccount.google.com/security
# 2. Activa Verificación en 2 pasos
# 3. Busca "Contraseñas de aplicaciones" y genera una para "MICAPA"
# 4. Pega la clave de 16 caracteres generada abajo en SMTP_PASS
# ===================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=micapacomayagua@gmail.com
SMTP_PASS=
SMTP_FROM="MICAPA - El Camino de la Palabra" <micapacomayagua@gmail.com>
CONTACT_EMAIL_TO=micapacomayagua@gmail.com
